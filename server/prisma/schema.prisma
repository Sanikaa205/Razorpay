generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model so `prisma generate` / `prisma migrate` work out of the box.
// Replace with real domain models as features are built.
model Ping {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
}
