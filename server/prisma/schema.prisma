generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ActionType {
  info_only
  order_attempt
  out_of_stock
}

enum OrderStatus {
  pending_approval
  auto_approved
  merchant_approved
  rejected
  paid
  failed
}

model Merchant {
  id                    String         @id @default(uuid())
  name                  String
  email                 String         @unique
  passwordHash          String
  razorpayAccountId     String?
  autoApproveLimit      Decimal        @default(0) @db.Decimal(10, 2)
  requireManualApproval Boolean        @default(false)
  createdAt             DateTime       @default(now())

  products      Product[]
  conversations Conversation[]
  orders        Order[]
  auditLogs     AuditLog[]

  @@map("merchants")
}

model Product {
  id         String   @id @default(uuid())
  merchantId String
  name       String
  price      Decimal  @db.Decimal(10, 2)
  material   String
  color      String
  sizeOptions String[]
  stock      Int      @default(0)
  photoUrl   String
  isAiReady  Boolean  @default(true)
  blocked    Boolean  @default(false)
  rawData    Json?
  createdAt  DateTime @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([merchantId])
  @@map("products")
}

model Conversation {
  id              String     @id @default(uuid())
  merchantId      String
  buyerQuery      String
  storeAiResponse String
  actionType      ActionType
  /// Stable per-browser-session identifier for the buyer/agent that asked this - never a real name/email, just enough to tell sessions apart in the dashboard.
  buyerSessionId  String?
  /// Who's on the other end of this conversation. Currently always "ai_agent" (the storefront's only entry point is the Simulated AI Buyer), kept as a real field rather than hardcoded copy so a genuine human-checkout channel could be added later without a schema change.
  buyerType       String     @default("ai_agent")
  createdAt       DateTime   @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@index([merchantId])
  @@map("conversations")
}

model Order {
  id               String      @id @default(uuid())
  merchantId       String
  productId        String
  conversationId   String?
  quantity         Int         @default(1)
  /// The size the buyer chose from the product's real sizeOptions at order time - never invented, always one of that product's actual options.
  selectedSize     String?
  orderValue       Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(pending_approval)
  /// True once this order's stock has actually been deducted from Product.stock - happens exactly once, only when the order reaches `paid`, so a retried/duplicate webhook can never double-deduct.
  stockDeducted    Boolean     @default(false)
  razorpayOrderId  String?
  razorpayPaymentId String?
  razorpayPaymentLinkId  String?
  razorpayPaymentLinkUrl String?
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  auditLogs    AuditLog[]

  @@index([merchantId])
  @@index([productId])
  @@index([conversationId])
  @@map("orders")
}

model AuditLog {
  id         String   @id @default(uuid())
  merchantId String?
  orderId    String?
  step       String
  outcome    String
  metadata   Json?
  timestamp  DateTime @default(now())

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([orderId])
  @@map("audit_logs")
}
